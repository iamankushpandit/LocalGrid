# ---- Flash and build ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../common/partitions_4mb.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# ---- Crypto: ChaCha20-Poly1305 for backbone frames ----
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y

# ---- Wi-Fi: memory-saving buffer rank for a no-PSRAM node ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
# Application AEAD replaces ESP-NOW encryption, so no hardware keys are taken from SoftAP stations.
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0

# ---- lwIP: up to 15 handheld sessions ----
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=16
CONFIG_LWIP_TCP_MSL=10000
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_IPV6=n

# ---- Bluetooth: NimBLE broadcaster only (owner decision: BLE in Phase 1) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
# D70: the read-only admin link needs a GATT server, so the peripheral role is on. One watcher at a
# time, no bonding and no BLE pairing: the link is sealed with the grid's own key instead.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n

# ---- A/B switches for link robustness (main/Kconfig.projbuild); both stay on in normal builds ----
# BLE advertising shares the radio with Wi-Fi and ESP-NOW. To test without it, add a line
#   CONFIG_LG_NODE_BLE_ADV=n
# and build with a fresh sdkconfig (see docs/milestones/P7-ap-mesh.md).
CONFIG_LG_NODE_BLE_ADV=y
# PMF capable on the SoftAP. For the reason-2 disassociation A/B, set CONFIG_LG_NODE_PMF_CAPABLE=n.
CONFIG_LG_NODE_PMF_CAPABLE=y

# ---- Watchdog: a stuck core task panics with a backtrace instead of only a warning ----
CONFIG_ESP_TASK_WDT_PANIC=y
