# ChaCha20-Poly1305 is off by default in ESP-IDF's Mbed TLS configuration.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y

# The simulation keeps several node and client cores alive at once.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../firmware/common/partitions_4mb.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
